# Copy to .env and fill in. Never commit .env.

# ArmorIQ (platform.armoriq.ai)
ARMORIQ_API_KEY=
ARMORIQ_AGENT_NAME=procurement-agent
ARMORIQ_MCP_NAME=procurement-mcp
ARMORIQ_APPROVAL_WAIT_SECONDS=60

# MCP server
MCP_PORT=8788
MCP_URL=https://<your-ngrok-domain>/mcp
RESET_SECRET=change-me

# ngrok (public URL for ArmorIQ to reach /mcp)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# LLM (OpenAI-compatible router, e.g. OpenRouter)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL_DEV=
LLM_MODEL_DEMO=

# ElevenLabs (voice approval)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Agent service
AGENT_SERVICE_URL=http://localhost:8787

# debug | info | warn | error
LOG_LEVEL=info
